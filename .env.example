# ---------------------------------------------------------------------------
# Aurum IQ — environment variables
#
# ONE Vercel project: Next.js at the repo root, the FastAPI engine mounted as
# Python serverless functions from api/. The rewrites in next.config.ts proxy
# same-origin /api/* requests to the engine.
# ---------------------------------------------------------------------------

# Data mode for the browser app.
#
#   same-origin            → LIVE data: /api/* is proxied to the FastAPI engine
#                            bundled in this repo (recommended; also "/api").
#   empty / unset          → demo fixtures (bundled, deterministic).
#   "https://backend.host" → LIVE data against an external backend instead.
NEXT_PUBLIC_API_BASE_URL=same-origin

# Milliseconds of simulated latency applied to demo responses so loading
# states are visible during development. Set to 0 to disable.
NEXT_PUBLIC_DEMO_LATENCY_MS=450

# Engine (optional; see api/app/config.py for defaults):
#   CORS_ORIGINS, DEFAULT_CARRY_PCT, BENCHMARK_RATE_PCT,
#   BROKERAGE_FLAT_INR, BROKERAGE_PCT, STATUTORY_BPS,
#   ANTHROPIC_API_KEY, OPENAI_API_KEY
