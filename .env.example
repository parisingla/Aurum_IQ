# ---------------------------------------------------------------------------
# Aurum IQ — environment variables
#
# The project deploys as ONE Vercel project with two services (see vercel.json):
#   backend/  → private FastAPI service
#   frontend/ → public Next.js service
#
# Frontend variables (NEXT_PUBLIC_*) are shell-variables for frontend/.
# Backend service variables are documented in backend/.env.example.
# ---------------------------------------------------------------------------

# Frontend: data-access mode.
#
#   unset / empty            → demo fixtures (bundled, deterministic)
#   "/api/backend"           → LIVE data through the same-origin bridge route in
#                              frontend/src/app/api/backend. Recommended on Vercel;
#                              BACKEND_URL is supplied automatically by the
#                              backend service binding. Locally it falls back to
#                              a FastAPI instance on 127.0.0.1:8000.
#   "https://backend.host"   → LIVE data against an externally hosted backend.
NEXT_PUBLIC_API_BASE_URL=

# Milliseconds of simulated latency applied to demo responses so loading
# states are visible during development. Set to 0 to disable.
NEXT_PUBLIC_DEMO_LATENCY_MS=

# Backend service (backend/.env.example has the full list):
#   PORT, HOST, CORS_ORIGINS, DEFAULT_CARRY_PCT, BENCHMARK_RATE_PCT,
#   BROKERAGE_FLAT_INR, BROKERAGE_PCT, STATUTORY_BPS, ANTHROPIC_API_KEY,
#   OPENAI_API_KEY
#
# Do NOT set BACKEND_URL manually — the Vercel Services binding injects it
# per deployment.
