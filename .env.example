# ---------------------------------------------------------------------------
# Aurum IQ — environment variables
#
# ONE Vercel project: Next.js at the repo root, the FastAPI engine mounted as
# Python serverless functions from api/. The rewrites in next.config.ts proxy
# same-origin /api/* requests to the engine.
# ---------------------------------------------------------------------------

# Data mode for the browser app.
#
#   same-origin            → LIVE data: /api/* is proxied to the FastAPI engine
#                            bundled in this repo (recommended; also "/api").
#   empty / unset          → demo fixtures (bundled, deterministic).
#   "https://backend.host" → LIVE data against an external backend instead.
NEXT_PUBLIC_API_BASE_URL=same-origin

# Milliseconds of simulated latency applied to demo responses so loading
# states are visible during development. Set to 0 to disable.
NEXT_PUBLIC_DEMO_LATENCY_MS=450

# Engine (optional; see api/app/config.py for defaults):
#   CORS_ORIGINS, DEFAULT_CARRY_PCT, BENCHMARK_RATE_PCT,
#   BROKERAGE_FLAT_INR, BROKERAGE_PCT, STATUTORY_BPS,
#   ANTHROPIC_API_KEY, OPENAI_API_KEY
#
# Upload persistence on Vercel (recommended): serverless instances keep no
# state between requests, so uploads would vanish. Add Upstash Redis in the
# Vercel dashboard (Project → Storage → Upstash Redis → free tier); the
# integration injects:
#   UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=...
# Uploads then survive instance recycles and redeploys. Unset locally, the
# engine behaves exactly as before (in-memory).
#
# AI mode (optional): OpenRouter narrative layer for POST /api/assistant/query.
# With a key set, the "Analyze my dataset" Result button sends the engine's
# computed fact brief to the LLM and returns mode:"llm"; without it (or on any
# failure) the deterministic template answers run as before. Get a key at
# openrouter.ai/keys. Model chain defaults to qwen/qwen3-30b-a3b-instruct-2507
# (OpenRouter deprecated the Qwen :free tier in Oct 2026) with a zero-cost
# fallback; override with OPENROUTER_MODEL.
#   OPENROUTER_API_KEY=sk-or-v1-...
#   OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
