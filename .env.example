# ---------------------------------------------------------------------------
# Aurum IQ environment variables
# ---------------------------------------------------------------------------

# Base URL of a real analytics backend (FastAPI / Next route handlers).
# Leave unset to run the app entirely on the bundled DEMO DATA fixtures.
# The data-access layer maps 1:1 to:
#   GET  /api/data/status
#   GET  /api/contracts
#   GET  /api/analytics/relative-value
#   GET  /api/analytics/term-structure
#   GET  /api/alerts
#   POST /api/backtests
#   GET  /api/backtests/:id
NEXT_PUBLIC_API_BASE_URL=

# Milliseconds of simulated latency applied to demo responses so loading
# states are visible during development. Set to 0 to disable.
NEXT_PUBLIC_DEMO_LATENCY_MS=450
