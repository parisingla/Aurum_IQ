# frontend/.env.example — copy to frontend/.env.local and adjust.
#
# Data-access mode for every page (src/lib/api/index.ts):
#
#   unset / empty    → demo fixtures (bundled, deterministic market data)
#   "/api/backend"   → LIVE data through the same-origin bridge route
#                      src/app/api/backend/[...path]/route.ts. On Vercel,
#                      BACKEND_URL comes from the backend service binding; for
#                      plain `npm run dev` it falls back to 127.0.0.1:8000, so
#                      start the backend too (python backend/run.py).
#   "https://host"   → LIVE data against an externally hosted backend.
NEXT_PUBLIC_API_BASE_URL=

# Milliseconds of simulated latency for demo responses. Set to 0 to disable.
NEXT_PUBLIC_DEMO_LATENCY_MS=450
